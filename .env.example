# FraudGraph environment — copy to .env and fill in. Never commit .env.

# --- Runtime mode ---
# local: pandas-backed graph (no TigerGraph required)
# tigergraph: live TigerGraph (Savanna or self-hosted)
FRAUDGRAPH_MODE=local

# --- Paths ---
# Directory containing transactions.csv, identity.csv, closed_cases_history.csv, case_pack.csv
DATA_DIR=data/raw
# Where local-mode indexes and case-memory files are written (gitignored)
PROCESSED_DIR=data/processed
# Benchmark JSON output directory
CASES_DIR=cases

# --- TigerGraph (required only when FRAUDGRAPH_MODE=tigergraph) ---
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=
# Preferred over username/password when available
TG_API_TOKEN=
TG_SECRET=
# REST++ port (9000 community, 443 Savanna). Leave blank to use pyTigerGraph default.
TG_RESTPP_PORT=
TG_GS_PORT=

# --- Official TigerGraph MCP server (optional) ---
# If set, the agent can also call tools exposed by github.com/tigergraph/tigergraph-mcp
TIGERGRAPH_MCP_COMMAND=tigergraph-mcp
TIGERGRAPH_MCP_ARGS=-vv
TIGERGRAPH_MCP_URL=

# --- LLM (optional; leave unset for deterministic template narration) ---
# Provider: none | openai | groq | anthropic | openai_compatible
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Max tokens for summary/SAR prose
LLM_MAX_TOKENS=800

# --- Application ---
LOG_LEVEL=INFO
# Streamlit
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
