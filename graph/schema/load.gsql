// Loading jobs for pre-exported slim CSVs produced by graph/ingestion.
// Empty primary IDs are rejected by TigerGraph >= 3.9 — WHERE clauses skip blanks.
//
// Files are generated by: python -m app.ingest --export
// Then run (via pyTigerGraph or GSQL):
//   RUN LOADING JOB load_fraud USING f_customers="...", ...

USE GRAPH FraudGraph

CREATE LOADING JOB load_fraud FOR GRAPH FraudGraph {
  DEFINE FILENAME f_customers;
  DEFINE FILENAME f_cards;
  DEFINE FILENAME f_devices;
  DEFINE FILENAME f_txns;
  DEFINE FILENAME f_next;
  DEFINE FILENAME f_closed;
  DEFINE FILENAME f_closed_txn;
  DEFINE FILENAME f_closed_conn;
  DEFINE FILENAME f_policy;
  DEFINE FILENAME f_emails;
  DEFINE FILENAME f_regions;

  LOAD f_customers
    TO VERTEX Customer VALUES ($"customer_id")
    USING header="true", separator=",";

  LOAD f_cards
    TO VERTEX Card VALUES ($"card_id", $"customer_id", $"network", $"card_type", $"card1"),
    TO EDGE OWNS VALUES ($"customer_id", $"card_id")
    USING header="true", separator=",";

  LOAD f_devices
    TO VERTEX DeviceProfile VALUES ($"device_id", $"device_info", $"os", $"browser", $"screen", $"device_type")
    USING header="true", separator=",", quote="double";

  LOAD f_emails
    TO VERTEX EmailDomain VALUES ($"domain")
    USING header="true", separator=",";

  LOAD f_regions
    TO VERTEX BillingRegion VALUES ($"region", $"country")
    USING header="true", separator=",";

  LOAD f_txns
    TO VERTEX Transaction VALUES (
      $"txn_id", $"ts", $"amount", $"product_cd", $"channel", $"risk_score",
      $"addr1", $"addr2", $"p_email", $"r_email", $"dist1", $"dist2",
      $"device_status", $"proxy", $"device_type"
    ),
    TO EDGE MADE VALUES ($"card_id", $"txn_id"),
    TO EDGE FROM_DEVICE VALUES ($"txn_id", $"device_id") WHERE $"device_id" != "",
    TO EDGE PURCHASER_EMAIL VALUES ($"txn_id", $"p_email") WHERE $"p_email" != "",
    TO EDGE RECIPIENT_EMAIL VALUES ($"txn_id", $"r_email") WHERE $"r_email" != "",
    TO EDGE BILLED_IN VALUES ($"txn_id", $"addr1") WHERE $"addr1" != ""
    USING header="true", separator=",", quote="double";

  LOAD f_next
    TO EDGE NEXT VALUES ($"from_txn", $"to_txn", $"gap_seconds")
    USING header="true", separator=",";

  LOAD f_closed
    TO VERTEX ClosedCase VALUES (
      $"case_id", $"customer_id", $"card_id", $"opened_at", $"closed_at",
      $"outcome", $"pattern", $"first_fraud_txn_id", $"txn_ids", $"n_txns",
      $"exposure_usd", $"connected_card_ids", $"actions_taken", $"report_filed",
      $"analyst_notes"
    ),
    TO EDGE ON_CARD VALUES ($"case_id", $"card_id") WHERE $"card_id" != ""
    USING header="true", separator=",", quote="double";

  LOAD f_closed_txn
    TO EDGE INVOLVES VALUES ($"case_id", $"txn_id")
    USING header="true", separator=",";

  LOAD f_closed_conn
    TO EDGE CONNECTED_TO VALUES ($"case_id", $"card_id")
    USING header="true", separator=",";

  LOAD f_policy
    TO VERTEX PolicyChunk VALUES ($"chunk_id", $"title", $"body", $"kind")
    USING header="true", separator=",", quote="double";
}
